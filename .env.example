# Configuration for LongCat-Xcode Bridge

# LongCat API Key (required)
# Get your key at: https://longcat.chat/platform/api_keys
# IMPORTANT: Set up billing (Token Pack or Pay-As-You-Go) as free quotas are no longer available
LONGCAT_API_KEY=your_api_key_here

# API Base URL (optional, defaults to https://api.longcat.chat/openai)
# LONGCAT_BASE=https://api.longcat.chat/openai
# Model Configuration (optional, defaults to LongCat-2.0)
# MODEL_NAME=LongCat-2.0

# Server Configuration
SERVER_HOST=0.0.0.0
SERVER_PORT=8000

# Feature Flags
SHOW_THINKING=false  # Show reasoning content in responses (for debugging)
DEBUG_MODE=false     # Enable debug logging
THINKING_ENABLED=false  # Enable LongCat-2.0 thinking mode (disabled by default for Xcode compatibility)

# Rate Limiting
MAX_CONCURRENT_REQUESTS=10
RATE_LIMIT_PER_MINUTE=60
